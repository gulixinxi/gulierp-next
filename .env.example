# Copy to .env.local for the Windows development launcher; never commit .env.local.
# Obtain the approved TEST database and credentials from the operator.
# Leave empty until configured. The launcher must fail closed on missing configuration.
ConnectionStrings__GuliERP=
# Only for initializing an empty development database. Set distinct, random
# values locally; never commit the filled file or reuse production credentials.
GULIERP_DEV_SEED_PLATFORM_ADMIN_PASSWORD=
GULIERP_DEV_SEED_TENANT_ADMIN_PASSWORD=
# Expected shape (placeholders only):
# Host=<test-host>;Port=5432;Database=<approved-test-db>;Username=<test-user>;Password=<secret>
